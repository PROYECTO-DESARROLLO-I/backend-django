# Copia este archivo como .env.production y completa los valores reales.
# NUNCA subas .env.production con valores reales al repositorio.

# Django
SECRET_KEY=coloca-aqui-una-secret-key-nueva-y-segura
DEBUG=False

# IP publica o dominio del EC2 (separados por coma si hay varios)
ALLOWED_HOSTS=ec2-xx-xx-xx-xx.compute-1.amazonaws.com

# URL del frontend en CloudFront (separados por coma si hay varios origenes)
CORS_ALLOWED_ORIGINS=https://dxxxxxxxxxxxxx.cloudfront.net
CSRF_TRUSTED_ORIGINS=https://dxxxxxxxxxxxxx.cloudfront.net

# URL del frontend, usada para enlaces de recuperacion de contrasena
FRONTEND_URL=https://dxxxxxxxxxxxxx.cloudfront.net

# Base de datos (Supabase / PostgreSQL)
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=coloca-aqui-la-password-real
DB_HOST=db.xxxxxxxxxxxxxxx.supabase.co
DB_PORT=5432
DB_SSLMODE=require

# Email
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=coloca-aqui-el-correo
EMAIL_HOST_PASSWORD=coloca-aqui-la-password-o-app-password
DEFAULT_FROM_EMAIL=noreply@saludagendax.com
